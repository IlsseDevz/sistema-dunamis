# Variáveis de ambiente — copie para .env e preencha localmente (não commitar .env)

# Perfil Spring (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Servidor (Render define PORT automaticamente)
PORT=8080

# MySQL — desenvolvimento local
DB_URL=jdbc:mysql://localhost:3306/dunamis_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# MySQL — produção (exemplo para Render + MySQL externo)
# DB_URL=jdbc:mysql://HOST:3306/dunamis_db?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=
# DB_PASSWORD=

# Schema JPA em produção (update na 1.ª implantação; validate quando houver migrações Flyway)
# JPA_DDL_AUTO=update

# Admin inicial (obrigatório no 1.º deploy em produção)
ADMIN_CONTACTO=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
